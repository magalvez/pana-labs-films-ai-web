{
  "name": "pana-films-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.ts & vite",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p . && tsc -p web",
    "test": "node --test \"server/**/*.test.ts\"",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.ts",
    "db:migrate:status": "node --env-file-if-exists=.env server/migrate.ts --status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.6",
    "@remotion/bundler": "^4.0.544",
    "@remotion/renderer": "^4.0.544",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.544",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
