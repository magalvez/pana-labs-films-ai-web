# Copia este archivo como .env y escribe ahí los valores. Nunca pongas claves en este archivo: sí se sube a git.

# Supabase > Connect > Session pooler (puerto 5432). Sustituye [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=
# Supabase > Project Settings > API
SUPABASE_URL=https://xtwxavtuiyxcyrkohzjp.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Correos con acceso a la app, separados por coma
ALLOWED_EMAILS=

# Agentes reales. Necesaria con el modo simulación apagado.
ANTHROPIC_API_KEY=

# Generación de imagen y video (fal.ai > API Keys). Con saldo cargado.
FAL_KEY=
# Voz, música y efectos (ElevenLabs > Developers > API Keys). La música exige un plan de pago.
ELEVENLABS_API_KEY=
# Revisión de video en movimiento (Google AI Studio > API keys). Sin ella los agentes revisan solo por cuadros.
GEMINI_API_KEY=
# Solo si la empresa tiene 4 personas o más: clave de la licencia de empresa de Remotion.
# REMOTION_LICENSE_KEY=

# Avisos por Telegram (opcional). Crea un bot con @BotFather y pega aquí su clave y su nombre de usuario, sin la arroba.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
